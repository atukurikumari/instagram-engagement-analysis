])

print("\nFIVE STRATEGIES FOR ALFIDO TECH")
display(strategies)

save_csv(strategies, "instagram_engagement_strategies.csv")

# ================================================================
# 15. EXPORT COMPLETE POST DATA
# ================================================================

save_csv(post_data, "instagram_post_engagement.csv")

if not day_analysis.empty:
    save_csv(day_analysis, "instagram_day_analysis.csv", index=True)

if not hour_analysis.empty:
    save_csv(hour_analysis, "instagram_hour_analysis.csv", index=True)

# ================================================================
# 16. FINAL OUTPUT
# ================================================================

print("\n" + "=" * 65)
print("INSTAGRAM ENGAGEMENT ANALYSIS COMPLETED")
print("=" * 65)

print("Total users:", users[user_id_col].nunique())
print("Total photos:", post_data["photo_id"].nunique())
print("Total likes:", int(post_data["likes"].sum()))

if comments is not None:
    print("Total comments:", len(comments))
else:
    print("Total comments: unavailable; comments.csv was not found.")

print("\nFiles saved in:", OUTPUT_DIR)

print("\nGENERATED REPORTS:")
for filename in sorted(os.listdir(OUTPUT_DIR)):
    print(filename)










